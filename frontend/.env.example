# EventHub frontend configuration reference.
#
# Angular does not read this file at runtime. Values are compiled into the bundle, so the
# settings live in the environment files and the dev proxy:
#
#   API_BASE_URL          -> src/environments/environment.ts (dev) and environment.production.ts
#                            Leave empty for same-origin calls (the default in both environments).
#                            Set e.g. http://localhost:8080 only if the API is on another origin;
#                            then the backend CORS_ORIGINS must include this frontend's origin.
#
#   DEV_API_PROXY_TARGET  -> proxy.conf.json (`/api` and `/uploads` targets)
#                            Defaults to http://localhost:8080, the Spring Boot server.
#
# Never put secrets here: the frontend is public. JWT signing secrets belong to the backend only.

API_BASE_URL=
DEV_API_PROXY_TARGET=http://localhost:8080
